# Public browser configuration used by Budgy. Never place the service-role key here.
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-public-anon-key

# Vela-specific Supabase project.
REACT_APP_SUPABASE_URL_VELA=https://your-vela-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY_VELA=your-vela-public-anon-key

# Nest-specific Supabase project. Use only the public anonymous key in the browser.
REACT_APP_SUPABASE_URL_NEST=https://your-nest-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY_NEST=your-nest-public-anon-key
